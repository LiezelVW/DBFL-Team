{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/team-profile-option(?:\\.html)?/?",
      "dest": "/team-profile-option.html"
    },
    {
      "src": "/$",
      "dest": "/index.html"
    },
    {
      "src": "/index\\.html",
      "dest": "/index.html"
    }
  ]
}
